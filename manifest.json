{
  "manifest_version": 3,
  "name": "Яндекс Видео — Скачать",
  "version": "1.1.0",
  "description": "Кнопки скачивания в поиске и плеере Яндекс Видео, а также на страницах VK Видео.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ya.ru/video/*",
        "https://yandex.ru/video/*",
        "https://*.yandex.ru/video/*",
        "https://vkvideo.ru/*",
        "https://vk.com/video*"
      ],
      "js": [
        "cards.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
